{
  "openapi": "3.0.3",
  "info": {
    "title": "PROVA Phase 4 Fixture API",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://127.0.0.1:4318" }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": { "type": "string", "enum": ["ok"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
