# Normalize line endings to LF in the repo, checked out as LF on
# every platform (avoids CRLF/BOM churn for Windows contributors).
* text=auto eol=lf

*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary business docs — don't attempt text diffs/normalization
*.docx binary
