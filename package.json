{
  "name": "@provae2e/cli",
  "version": "0.1.0",
  "description": "AI-native QE automation platform — browser, mobile, and API testing",
  "bin": {
    "qe-tool": "./dist/cli/run.js",
    "prova": "./dist/cli/run.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build":       "tsc",
    "dev":         "tsc --watch",
    "start":       "node dist/cli/run.js",
    "test":        "jest --passWithNoTests",
    "test:watch":  "jest --watch",
    "test:ci":     "jest --ci --coverage --forceExit",
    "lint":        "eslint src tests",
    "lint:fix":    "eslint src tests --fix",
    "typecheck":   "tsc --noEmit",
    "clean":       "rm -rf dist coverage",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "keywords": ["testing", "automation", "playwright", "qe", "ai", "browser-testing", "api-testing"],
  "author": "Ajay — PROVA",
  "license": "MIT",
  "engines": { "node": ">=20.0.0" },
  "dependencies": {
    "@playwright/test":  "^1.44.0",
    "commander":         "^12.0.0",
    "chalk":             "^5.3.0",
    "ora":               "^8.0.0",
    "yaml":              "^2.4.0",
    "axios":             "^1.7.0",
    "allure-playwright": "^2.14.0"
  },
  "devDependencies": {
    "@types/jest":            "^29.5.0",
    "@types/node":            "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser":        "^7.0.0",
    "eslint":                           "^8.57.0",
    "jest":                             "^29.7.0",
    "ts-jest":                          "^29.1.0",
    "typescript":                       "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": ["src/**/*.ts", "!src/**/*.d.ts"]
  }
}
