{
  "name": "@provae2e/cli",
  "version": "0.2.0",
  "description": "CLI-first browser, mobile, and API test automation powered by Playwright",
  "bin": {
    "qe-tool": "./dist/cli/run.js",
    "prova": "./dist/cli/run.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    ".env.promotion.example",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/run.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --forceExit",
    "test:smoke": "jest --testPathPattern=tests/smoke --forceExit",
    "test:phase2:e2e": "npm run build && node scripts/phase2-e2e.js",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.js",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run lint && npm run test:ci && npm run build"
  },
  "keywords": [
    "testing",
    "test-automation",
    "e2e",
    "playwright",
    "quality-engineering",
    "cli",
    "browser-testing",
    "mobile-testing",
    "api-testing",
    "self-healing"
  ],
  "author": "Ajay — PROVA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajaygh99/provae2e.git"
  },
  "homepage": "https://github.com/ajaygh99/provae2e#readme",
  "bugs": {
    "url": "https://github.com/ajaygh99/provae2e/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.44.0",
    "allure-playwright": "^2.14.0",
    "axios": "^1.7.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.0",
    "sql.js": "^1.14.1",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
