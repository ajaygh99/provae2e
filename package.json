{
  "name": "@provae2e/cli",
  "version": "0.3.5-beta.1",
  "description": "CLI-first browser, mobile, and API test automation powered by Playwright",
  "bin": {
    "qe-tool": "./dist/cli/run.js",
    "prova": "./dist/cli/run.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    ".env.promotion.example",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "docs/BETA-LAUNCH-SECURITY.md",
    "docs/NATIVE-MOBILE.md",
    "docs/INTEGRATIONS.md",
    "docs/PHASE4-BETA-GUIDE.md",
    "docs/PHASE4-BETA-ROLLBACK.md",
    "releases/v0.3.5-beta.1.md",
    "releases/v0.3.5-beta.1-phase4-candidate.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/run.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --forceExit",
    "test:smoke": "jest --testPathPatterns=tests/smoke --forceExit",
    "test:slice2": "npm run build && node scripts/slice2-failure-runner.js artifacts/slice2 && node scripts/slice2-validate-evidence.js artifacts/slice2",
    "test:slice3": "npm run build && node scripts/slice3-analytics-runner.js artifacts/slice3",
    "test:phase2:e2e": "npm run build && node scripts/phase2-e2e.js",
    "validate:perf": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-phase4-performance.ps1",
    "validate:security": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-phase4-security.ps1",
    "validate:analytics": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-phase4-analytics.ps1",
    "validate:native": "node ./scripts/validate-phase4-native.js",
    "validate:integrations": "node ./scripts/validate-phase4-integrations.js",
    "validate:phase4-beta": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-phase4-beta.ps1",
    "verify:phase4-package": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-phase4-package.ps1",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.js",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run lint && npm run test:ci && npm run build"
  },
  "keywords": [
    "testing",
    "test-automation",
    "e2e",
    "playwright",
    "quality-engineering",
    "cli",
    "browser-testing",
    "mobile-testing",
    "api-testing",
    "self-healing"
  ],
  "author": "Ajay — PROVA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajaygh99/provae2e.git"
  },
  "homepage": "https://github.com/ajaygh99/provae2e#readme",
  "bugs": {
    "url": "https://github.com/ajaygh99/provae2e/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.44.0",
    "allure-playwright": "^2.14.0",
    "axios": "^1.7.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.0",
    "pg": "^8.22.0",
    "sql.js": "^1.14.1",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@swc/core": "^1.13.5",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "js-yaml": "^4.1.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "glob": "13.0.6",
    "test-exclude": "8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "transform": {
      "^.+\\.tsx?$": [
        "@swc/jest"
      ]
    },
    "testMatch": [
      "**/*.test.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageProvider": "v8",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
